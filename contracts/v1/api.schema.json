{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haunted-ai.invalid/contracts/v1/api.schema.json",
  "title": "Haunted AI API 1.0.0",
  "$defs": {
    "AI": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "live",
            "demo",
            "fallback",
            "not_used"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "timeout",
                "unavailable",
                "invalid_output",
                "provider_error"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ollama"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "reason",
        "provider",
        "model"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "live"
              }
            }
          },
          "then": {
            "properties": {
              "provider": {
                "const": "ollama"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "demo",
                  "not_used"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "provider": {
                "type": "null"
              },
              "model": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "fallback"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "timeout",
                  "unavailable",
                  "invalid_output",
                  "provider_error"
                ]
              }
            }
          }
        }
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "cue_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sequence",
        "cue_id",
        "summary"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "audio",
            "font"
          ]
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "attribution_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "width": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "src",
        "alt",
        "attribution_id",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "Bounds": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "Layer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "z_index": {
          "type": "integer"
        },
        "parallax_factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decorative": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "asset_id",
        "z_index",
        "parallax_factor",
        "decorative"
      ],
      "additionalProperties": false
    },
    "Interaction": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "open",
            "close",
            "activate"
          ]
        },
        "label": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "disabled_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "label",
        "enabled",
        "disabled_reason"
      ],
      "additionalProperties": false
    },
    "Hotspot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "object_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "label": {
          "type": "string"
        },
        "focus_order": {
          "type": "integer",
          "minimum": 0
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Interaction"
          }
        }
      },
      "required": [
        "id",
        "object_id",
        "label",
        "focus_order",
        "bounds",
        "interactions"
      ],
      "additionalProperties": false
    },
    "Scene": {
      "type": "object",
      "properties": {
        "room_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Layer"
          }
        },
        "hotspots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hotspot"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 80
              },
              "state": {
                "type": "string",
                "enum": [
                  "closed",
                  "open",
                  "inactive",
                  "active",
                  "calibrated"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "state",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "ambient_audio_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "canvas": {
          "type": "object",
          "properties": {
            "width": {
              "const": 1600
            },
            "height": {
              "const": 900
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "room_id",
        "title",
        "description",
        "layers",
        "hotspots",
        "objects",
        "ambient_audio_asset_id",
        "canvas"
      ],
      "additionalProperties": false
    },
    "Room": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "title": {
          "type": "string"
        },
        "unlocked": {
          "type": "boolean"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "unlocked",
        "hint"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "room_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "room_id",
        "asset_id",
        "annotations"
      ],
      "additionalProperties": false
    },
    "Insight": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "LetterPresentation": {
      "type": "object",
      "properties": {
        "pieces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 80
              },
              "text": {
                "type": "string"
              },
              "asset_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "text",
              "asset_id"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 80
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "pieces",
        "slots"
      ],
      "additionalProperties": false
    },
    "CalibrationPresentation": {
      "type": "object",
      "properties": {
        "controls": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "power_level"
                  },
                  "kind": {
                    "const": "integer"
                  },
                  "label": {
                    "type": "string"
                  },
                  "minimum": {
                    "const": 0
                  },
                  "maximum": {
                    "const": 3
                  },
                  "step": {
                    "const": 1
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "label",
                  "minimum",
                  "maximum",
                  "step"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "phase"
                  },
                  "kind": {
                    "const": "choice"
                  },
                  "label": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "enum": [
                            "amber",
                            "violet",
                            "cyan"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "value",
                        "label"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "allOf": [
                      {
                        "contains": {
                          "properties": {
                            "value": {
                              "const": "amber"
                            }
                          }
                        },
                        "minContains": 1,
                        "maxContains": 1
                      },
                      {
                        "contains": {
                          "properties": {
                            "value": {
                              "const": "violet"
                            }
                          }
                        },
                        "minContains": 1,
                        "maxContains": 1
                      },
                      {
                        "contains": {
                          "properties": {
                            "value": {
                              "const": "cyan"
                            }
                          }
                        },
                        "minContains": 1,
                        "maxContains": 1
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "label",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "stabilizer"
                  },
                  "kind": {
                    "const": "choice"
                  },
                  "label": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "enum": [
                            "bypass",
                            "engaged"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "value",
                        "label"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "allOf": [
                      {
                        "contains": {
                          "properties": {
                            "value": {
                              "const": "bypass"
                            }
                          }
                        },
                        "minContains": 1,
                        "maxContains": 1
                      },
                      {
                        "contains": {
                          "properties": {
                            "value": {
                              "const": "engaged"
                            }
                          }
                        },
                        "minContains": 1,
                        "maxContains": 1
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "label",
                  "options"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 3,
          "maxItems": 3,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "power_level"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "phase"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "stabilizer"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "instructions": {
          "type": "string"
        }
      },
      "required": [
        "controls",
        "instructions"
      ],
      "additionalProperties": false
    },
    "Puzzle": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "letter_reconstruction"
            },
            "status": {
              "type": "string",
              "enum": [
                "available",
                "solved"
              ]
            },
            "presentation": {
              "$ref": "#/$defs/LetterPresentation"
            }
          },
          "required": [
            "id",
            "status",
            "presentation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "machine_calibration"
            },
            "status": {
              "type": "string",
              "enum": [
                "available",
                "solved"
              ]
            },
            "presentation": {
              "$ref": "#/$defs/CalibrationPresentation"
            }
          },
          "required": [
            "id",
            "status",
            "presentation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Ghost": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "eleanor",
            "thomas",
            "clara"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "trust": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "suspicion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "emotion": {
          "type": "string",
          "enum": [
            "guarded",
            "nervous",
            "receptive",
            "distressed",
            "calm"
          ]
        },
        "portrait_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "display_name",
        "available",
        "trust",
        "suspicion",
        "emotion",
        "portrait_asset_id"
      ],
      "additionalProperties": false
    },
    "Turn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "ghost_id": {
          "type": "string",
          "enum": [
            "eleanor",
            "thomas",
            "clara"
          ]
        },
        "player_message": {
          "type": "string"
        },
        "response_text": {
          "type": "string"
        },
        "ai": {
          "$ref": "#/$defs/AI"
        }
      },
      "required": [
        "id",
        "ghost_id",
        "player_message",
        "response_text",
        "ai"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "ClaimOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "group": {
          "type": "string",
          "enum": [
            "eleanor_action",
            "eleanor_motive",
            "thomas_action",
            "thomas_motive",
            "cause"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "group",
        "label"
      ],
      "additionalProperties": false
    },
    "Ending": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "truth_revealed",
            "partial_truth",
            "false_accusation"
          ]
        },
        "title": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "supported_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "uniqueItems": true
        },
        "missing_summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "explanation",
        "supported_claim_ids",
        "missing_summary"
      ],
      "additionalProperties": false
    },
    "Descriptor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "navigate",
            "inspect",
            "interact_object",
            "submit_puzzle",
            "connect_evidence",
            "talk",
            "accuse"
          ]
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
